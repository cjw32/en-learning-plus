//用户表
model User {
  id                       String                    @id @default(cuid()) // 用户ID
  name                     String // 用户名
  email                    String?                   @unique // 邮箱
  phone                    String                    @unique // 手机号
  address                  String? // 地址
  password                 String // 密码
  avatar                   String? // 头像
  bio                      String? // 签名  新增字段
  isTimingTask             Boolean                   @default(false) // 是否开启定时任务 新增字段
  timingTaskTime           String                    @default("00:00:00") //定时任务时间默认晚上0点开始，每隔24小时执行一次 新增字段
  wordNumber               Int                       @default(0) // 单词数量
  studyDays                UserStudyDay[]
  dayNumber                Int                       @default(0) // 打卡天数
  createdAt                DateTime                  @default(now()) // 创建时间
  updatedAt                DateTime                  @updatedAt // 更新时间
  lastLoginAt              DateTime? // 最后登录时间
  wordBookRecords          WordBookRecord[]
  paymentRecords           PaymentRecord[]
  courseRecords            CourseRecord[]
  visitors                 Visitor[] //User别忘记关联
  learnerProfile           LearnerProfile?
  learningItemStates       LearningItemState[]
  learningReviewEvents     LearningReviewEvent[]
  coachConversations       CoachConversation[]
  coachRequests            CoachRequest[]
  exercises                Exercise[]
  exerciseSubmissions      ExerciseSubmission[]
  learningAttempts         LearningAttempt[]
  coachFeedback            CoachFeedback[]
  traceSubjectMapping      TraceSubjectMapping?
  knowledgeDocuments       KnowledgeDocument[]
  privateLearningSummaries PrivateLearningSummary[]
  pronunciationAssessments PronunciationAssessment[]
  pronunciationTargets     PronunciationTarget[]
  pronunciationAudioAssets PronunciationAudioAsset[]
  mcpSubjectMappings       McpSubjectMapping[]
  mcpClientAuthorizations  McpClientAuthorization[]
  mcpInvocations           McpInvocation[]
  mcpIdempotencyIntents    McpIdempotencyIntent[]
  mcpWriteConfirmations    McpWriteConfirmation[]
}

//记录已操作的单词
model WordBookRecord {
  id        String   @id @default(cuid()) // 记录ID
  wordId    String // 单词ID
  isMaster  Boolean  @default(false) // 是否掌握
  createdAt DateTime @default(now()) // 创建时间
  updatedAt DateTime @updatedAt // 更新时间
  userId    String // 用户ID
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  word      WordBook @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
}

//单词表
model WordBook {
  id                           String                        @id @default(cuid()) // 单词ID
  word                         String // 单词
  phonetic                     String? // 音标
  definition                   String? // 定义
  translation                  String? // 翻译
  pos                          String? // 词性
  collins                      String? // 柯林斯
  oxford                       String? // 牛津
  tag                          String? // 标签
  bnc                          String? // BNC 英国国家语料库
  frq                          String? // FRQ 频率
  exchange                     String? // 同义词
  gk                           Boolean? // 高考
  zk                           Boolean? // 中考
  gre                          Boolean? // GRE
  toefl                        Boolean? // TOEFL
  ielts                        Boolean? // IELTS
  cet6                         Boolean? // 大学英语六级
  cet4                         Boolean? // 大学英语四级
  ky                           Boolean? // 考研
  createdAt                    DateTime                      @default(now()) // 创建时间
  updatedAt                    DateTime                      @updatedAt // 更新时间
  wordBookRecords              WordBookRecord[]
  learningItemStates           LearningItemState[]
  exerciseItemTargets          ExerciseItemTarget[]
  knowledgeDocuments           KnowledgeDocument[]
  pronunciationTargets         PronunciationTarget[]
  pronunciationWordAssessments PronunciationWordAssessment[]

  @@index([word])
  @@index([tag])
  @@index([word, tag])
}

//支付记录
model PaymentRecord {
  id            String         @id @default(cuid()) // 支付ID
  userId        String // 用户ID
  tradeNo       String? // 支付宝交易号
  outTradeNo    String         @unique // 订单编号
  amount        Decimal // 支付金额
  subject       String // 支付主题
  body          String // 支付内容
  tradeStatus   TradeStatus    @default(NOT_PAY) // 支付状态 默认未支付 NOT_PAY, SUCCESS, FAILED
  sendPayTime   DateTime? // 支付时间
  createdAt     DateTime       @default(now()) // 创建时间
  updatedAt     DateTime       @updatedAt // 更新时间
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseRecords CourseRecord[]

  @@index([tradeNo])
}

model CourseRecord {
  id              String         @id @default(cuid()) // 课程记录ID
  userId          String // 用户ID
  courseId        String // 课程ID
  isPurchased     Boolean        @default(false) // 是否购买
  createdAt       DateTime       @default(now()) // 创建时间
  updatedAt       DateTime       @updatedAt // 更新时间
  paymentRecordId String? // 支付记录ID
  paymentRecord   PaymentRecord? @relation(fields: [paymentRecordId], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  course          Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Course {
  id                   String                @id @default(cuid()) // 课程ID
  name                 String // 课程名
  value                String // 课程value
  description          String? // 课程描述
  teacher              String // 教师
  url                  String // 课程url
  price                Decimal // 课程价格
  createdAt            DateTime              @default(now()) // 创建时间
  updatedAt            DateTime              @updatedAt // 更新时间
  courseRecords        CourseRecord[]
  learnerProfiles      LearnerProfile[]
  knowledgeDocuments   KnowledgeDocument[]
  pronunciationTargets PronunciationTarget[]
}

model LearnerProfile {
  id             String              @id @default(cuid())
  userId         String              @unique
  cefrLevel      CefrLevel?
  levelSource    LearnerLevelSource?
  goalType       LearnerGoalType?
  goalText       String?             @db.VarChar(500)
  activeCourseId String?
  timezone       String              @default("Asia/Shanghai") @db.VarChar(64)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeCourse   Course?             @relation(fields: [activeCourseId], references: [id], onDelete: SetNull)

  @@index([activeCourseId])
}

model LearningItemState {
  id                  String                            @id @default(cuid())
  userId              String
  targetType          LearningTargetType
  targetKey           String                            @db.VarChar(128)
  wordId              String?
  reviewState         LearningReviewState               @default(NEW)
  repetitionCount     Int                               @default(0)
  easeFactor          Decimal                           @default(2.5) @db.Decimal(4, 2)
  intervalDays        Int                               @default(0)
  dueAt               DateTime?
  lastReviewedAt      DateTime?
  lastQuality         Int?
  lastAttemptId       String?
  createdAt           DateTime                          @default(now())
  updatedAt           DateTime                          @updatedAt
  user                User                              @relation(fields: [userId], references: [id], onDelete: Cascade)
  word                WordBook?                         @relation(fields: [wordId], references: [id], onDelete: Cascade)
  lastAttempt         LearningAttempt?                  @relation("LatestItemAttempt", fields: [lastAttemptId], references: [id], onDelete: SetNull)
  reviewEvents        LearningReviewEvent[]
  recalculationEvents LearningStateRecalculationEvent[]

  @@unique([userId, targetType, targetKey])
  @@index([userId, targetType, dueAt])
  @@index([wordId])
}

model LearningReviewEvent {
  id               String               @id @default(cuid())
  userId           String
  itemStateId      String
  attemptId        String
  targetType       LearningTargetType
  targetKey        String               @db.VarChar(128)
  itemScore        Int
  quality          Int
  previousState    Json
  nextState        Json
  evidenceKind     LearningEvidenceKind @default(EXERCISE_GRADING)
  schedulerVersion String               @default("SM2_V1") @db.VarChar(64)
  policyVersion    String               @default("coach-attempt.v1") @db.VarChar(64)
  voidedAt         DateTime?
  createdAt        DateTime             @default(now())
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemState        LearningItemState    @relation(fields: [itemStateId], references: [id], onDelete: Cascade)
  attempt          LearningAttempt      @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, targetType, targetKey])
  @@index([userId, createdAt])
  @@index([itemStateId, createdAt])
}

model CoachConversation {
  id                 String                  @id @default(cuid())
  userId             String
  title              String?                 @db.VarChar(120)
  status             CoachConversationStatus @default(ACTIVE)
  origin             CoachConversationOrigin @default(COACH)
  checkpointThreadId String                  @unique @db.VarChar(128)
  lastActivityAt     DateTime                @default(now())
  expiresAt          DateTime
  deletedAt          DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages           CoachMessage[]
  requests           CoachRequest[]
  exercises          Exercise[]

  @@index([userId, origin, status, lastActivityAt])
}

model CoachMessage {
  id                  String            @id @default(cuid())
  conversationId      String
  requestId           String?
  role                CoachMessageRole
  content             String?
  resultSchemaVersion String?           @db.VarChar(64)
  structuredResult    Json?
  createdAt           DateTime          @default(now())
  conversation        CoachConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  request             CoachRequest?     @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt, id])
  @@index([requestId])
}

model CoachRequest {
  id                       String                @id @default(cuid())
  userId                   String
  conversationId           String
  clientRequestKey         String                @db.VarChar(128)
  requestBodyHash          String                @db.VarChar(128)
  inputPayload             Json
  retryOfRequestId         String?
  inputType                CoachRequestInputType
  intent                   CoachIntent?
  status                   CoachRequestStatus    @default(CREATED)
  exerciseId               String?
  answerVersion            String?               @db.VarChar(128)
  promptVersion            String?               @db.VarChar(128)
  modelVersion             String?               @db.VarChar(128)
  budgetVersion            String?               @db.VarChar(128)
  deadlineAt               DateTime
  finalResultSchemaVersion String?               @db.VarChar(64)
  finalResult              Json?
  errorCode                CoachErrorCode?
  cancelRequestedAt        DateTime?
  queuedAt                 DateTime?
  startedAt                DateTime?
  firstTokenAt             DateTime?
  finishedAt               DateTime?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  user                     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation             CoachConversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  retryOfRequest           CoachRequest?         @relation("CoachRequestRetries", fields: [retryOfRequestId], references: [id], onDelete: SetNull)
  retries                  CoachRequest[]        @relation("CoachRequestRetries")
  exercise                 Exercise?             @relation("RequestExerciseContext", fields: [exerciseId], references: [id], onDelete: SetNull)
  generatedExercise        Exercise?             @relation("ExerciseGenerationRequest")
  messages                 CoachMessage[]
  gradedSubmission         ExerciseSubmission?   @relation("SubmissionGradeRequest")
  savedAttempt             LearningAttempt?      @relation("AttemptSaveRequest")
  trace                    CoachTrace?
  feedback                 CoachFeedback[]
  knowledgeCitations       KnowledgeCitation[]
  pronunciationTargets     PronunciationTarget[]
  mcpInvocation            McpInvocation?

  @@unique([userId, clientRequestKey])
  @@index([conversationId, status, createdAt])
  @@index([retryOfRequestId])
  @@index([exerciseId])
}

model Exercise {
  id                    String                 @id @default(cuid())
  userId                String
  conversationId        String
  requestId             String                 @unique
  type                  ExerciseType
  status                ExerciseStatus         @default(DRAFT)
  cefrDifficulty        ExerciseDifficulty
  instructions          String                 @db.VarChar(2000)
  personalizationReason String                 @db.VarChar(2000)
  schemaVersion         String                 @db.VarChar(64)
  citations             Json
  expiresAt             DateTime
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation          CoachConversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  request               CoachRequest           @relation("ExerciseGenerationRequest", fields: [requestId], references: [id], onDelete: Cascade)
  contextualRequests    CoachRequest[]         @relation("RequestExerciseContext")
  items                 ExerciseItem[]
  submissions           ExerciseSubmission[]
  attempts              LearningAttempt[]
  mcpIdempotencyIntents McpIdempotencyIntent[]
  mcpWriteConfirmations McpWriteConfirmation[]

  @@index([userId, status, createdAt])
  @@index([conversationId])
}

model ExerciseItem {
  id              String                   @id @default(cuid())
  exerciseId      String
  position        Int
  prompt          String
  choices         Json?
  answerKey       Json
  gradingRubric   Json
  maxScore        Int
  citations       Json
  exercise        Exercise                 @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  targets         ExerciseItemTarget[]
  submissionItems ExerciseSubmissionItem[]

  @@unique([exerciseId, position])
}

model ExerciseItemTarget {
  exerciseItemId String
  targetType     LearningTargetType
  targetKey      String             @db.VarChar(128)
  wordId         String?
  weight         Decimal            @db.Decimal(5, 4)
  exerciseItem   ExerciseItem       @relation(fields: [exerciseItemId], references: [id], onDelete: Cascade)
  word           WordBook?          @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@id([exerciseItemId, targetType, targetKey])
  @@index([wordId])
}

model ExerciseSubmission {
  id                    String                   @id @default(cuid())
  userId                String
  exerciseId            String
  gradeRequestId        String                   @unique
  answerVersion         String                   @db.VarChar(128)
  clientIdempotencyKey  String                   @db.VarChar(128)
  answers               Json
  status                ExerciseSubmissionStatus @default(RECEIVED)
  score                 Int?
  gradingHash           String?                  @db.VarChar(128)
  resultSchemaVersion   String?                  @db.VarChar(64)
  gradingResult         Json?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  user                  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise              Exercise                 @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  gradeRequest          CoachRequest             @relation("SubmissionGradeRequest", fields: [gradeRequestId], references: [id], onDelete: Cascade)
  items                 ExerciseSubmissionItem[]
  attempt               LearningAttempt?
