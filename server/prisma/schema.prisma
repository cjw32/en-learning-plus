// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../libs/shared/src/generated/prisma"
  moduleFormat = "cjs" // 模块格式
}

datasource db {
  provider = "postgresql"
}

enum TradeStatus {
  NOT_PAY // 未支付 默认值非支付宝枚举 自定义
  WAIT_BUYER_PAY // 等待买家付款
  TRADE_CLOSED // 交易关闭
  TRADE_SUCCESS // 交易成功 可退款
  TRADE_FINISHED // 交易结束 不可退款
}

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum LearnerLevelSource {
  USER_DECLARED
}

enum LearnerGoalType {
  GENERAL
  EXAM
  BUSINESS
  TRAVEL
  CUSTOM
}

enum LearningTargetType {
  WORD
  ERROR_TYPE
}

enum LearningReviewState {
  NEW
  LEARNING
  REVIEW
  MASTERED
}

enum CoachConversationStatus {
  ACTIVE
  DELETING
  DELETED
  EXPIRED
}

enum CoachMessageRole {
  USER
  COACH
}

enum CoachRequestInputType {
  MESSAGE
  EXERCISE_SUBMISSION
  RECOMMENDATION
}

enum CoachIntent {
  ANSWER
  CORRECTION
  CREATE_EXERCISE
  GRADE_ANSWER
  REVIEW_RECOMMENDATION
  UNKNOWN
}

enum CoachRequestStatus {
  CREATED
  QUEUED
  RUNNING
  COMPLETED
  CANCELLED
  TIMED_OUT
  BUDGET_EXCEEDED
  FAILED
}

enum CoachResponseType {
  ANSWER
  CORRECTION
  EXERCISE
  GRADING
  RECOMMENDATION
  DEGRADED
}

enum CoachErrorCode {
  AUTH_REQUIRED
  TOKEN_INVALID
  FORBIDDEN
  RESOURCE_NOT_FOUND
  VALIDATION_FAILED
  SCHEMA_INVALID
  MATERIAL_NOT_AVAILABLE
  MODEL_UNAVAILABLE
  TOOL_TIMEOUT
  REQUEST_TIMEOUT
  BUDGET_EXCEEDED
  RATE_LIMITED
  IDEMPOTENCY_CONFLICT
  STATE_CONFLICT
  CANCELLED
  INTERNAL_ERROR
}

enum ExerciseType {
  MULTIPLE_CHOICE
  FILL_BLANK
  TRANSLATION
  SITUATIONAL_DIALOGUE
}

enum ExerciseDifficulty {
  A1
  A2
  B1
  B2
  C1
  C2
  UNKNOWN
}

enum ExerciseStatus {
  DRAFT
  READY
  SUBMITTED
  GRADED
  SAVED
  EXPIRED
  CANCELLED
}

enum ExerciseSubmissionStatus {
  RECEIVED
  GRADING
  GRADED_VALID
  GRADING_FAILED
  SAVED
}

enum CoachStepName {
  CLASSIFY_INTENT
  GET_LEARNER_PROFILE
  GET_DUE_WORDS
  SEARCH_LEARNING_MATERIALS
  CREATE_EXERCISE
  GRADE_ANSWER
  SAVE_ATTEMPT
  GENERATE_ANSWER
  RECOMMEND
  VALIDATE_RESULT
  FINALIZE
}

enum CoachToolName {
  GET_LEARNER_PROFILE
  GET_DUE_WORDS
  SEARCH_LEARNING_MATERIALS
  CREATE_EXERCISE
  GRADE_ANSWER
  SAVE_ATTEMPT
}

enum CoachStepStatus {
  STARTED
  SUCCEEDED
  FAILED
  SKIPPED
  CANCELLED
  TIMED_OUT
}

enum CoachFeedbackRating {
  UP
  DOWN
}

enum CoachFeedbackCategory {
  INCORRECT
  TOO_HARD
  TOO_EASY
  IRRELEVANT
  UNSAFE
  OTHER
}

enum CoachDeletionScope {
  CONVERSATION
  COACH_DATA
}

enum CoachDeletionStatus {
  ACCEPTED
  PURGING
  COMPLETED
}

enum KnowledgeSourceStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  EXPIRED
  REVOKED
  DELETED
}

enum KnowledgeAccessScope {
  PUBLIC
  OWNED_COURSE
  PRIVATE_OWNER
}

enum KnowledgeDocumentStatus {
  STAGED
  ACTIVE
  SUPERSEDED
  INVALID
  PURGING
  PURGED
}

enum KnowledgeChunkStatus {
  STAGED
  ACTIVE
  SUPERSEDED
  INVALID
  PURGING
}

enum KnowledgeEmbeddingStatus {
  PENDING
  READY
  FAILED
  INVALID
  PURGING
}

enum KnowledgeReleaseStatus {
  BUILDING
  READY
  ACTIVE
  SUPERSEDED
  INVALID
  PURGED
}

enum KnowledgeIngestionOperation {
  UPSERT
  REEMBED
  INVALIDATE
  PURGE
}

enum KnowledgeIngestionStatus {
  PENDING
  DISPATCHED
  RUNNING
  SUCCEEDED
  RETRYABLE_FAILED
  TERMINAL_FAILED
  CANCELLED
}

enum KnowledgeCitationStatus {
  ACTIVE
  SUPERSEDED
  SOURCE_INVALID
  ACCESS_REVOKED
  SOURCE_DELETED
  PRIVATE_DATA_DELETED
  PURGED
}

enum KnowledgeCategory {
  WORD_MEANING
  WORD_TRANSLATION
  WORD_PRONUNCIATION
  WORD_FORM
  WORD_USAGE
  COLLOCATION
  EXAMPLE_SENTENCE
  GRAMMAR_RULE
  GRAMMAR_EXCEPTION
  COURSE_LESSON
  EXERCISE_KNOWLEDGE
  USER_ERROR
  LEARNING_SUMMARY
}

enum PrivateLearningSummaryTopicType {
  WORD
  ERROR_TYPE
  COURSE_TOPIC
}

enum PrivateLearningSummaryStatus {
  ACTIVE
  SUPERSEDED
  DELETING
}

//用户表
model User {
  id                   String                @id @default(cuid()) // 用户ID
  name                 String // 用户名
  email                String?               @unique // 邮箱
  phone                String                @unique // 手机号
  address              String? // 地址
  password             String // 密码
  avatar               String? // 头像
  bio                  String? // 签名  新增字段
  isTimingTask         Boolean               @default(false) // 是否开启定时任务 新增字段
  timingTaskTime       String                @default("00:00:00") //定时任务时间默认晚上0点开始，每隔24小时执行一次 新增字段
  wordNumber           Int                   @default(0) // 单词数量
  dayNumber            Int                   @default(0) // 打卡天数
  createdAt            DateTime              @default(now()) // 创建时间
  updatedAt            DateTime              @updatedAt // 更新时间
  lastLoginAt          DateTime? // 最后登录时间
  wordBookRecords      WordBookRecord[]
  paymentRecords       PaymentRecord[]
  courseRecords        CourseRecord[]
  visitors             Visitor[] //User别忘记关联
  learnerProfile       LearnerProfile?
  learningItemStates   LearningItemState[]
  learningReviewEvents LearningReviewEvent[]
  coachConversations   CoachConversation[]
  coachRequests        CoachRequest[]
  exercises            Exercise[]
  exerciseSubmissions  ExerciseSubmission[]
  learningAttempts     LearningAttempt[]
  coachFeedback        CoachFeedback[]
  traceSubjectMapping  TraceSubjectMapping?
  knowledgeDocuments   KnowledgeDocument[]
  privateLearningSummaries PrivateLearningSummary[]
}

//记录已操作的单词
model WordBookRecord {
  id        String   @id @default(cuid()) // 记录ID
  wordId    String // 单词ID
  isMaster  Boolean  @default(false) // 是否掌握
  createdAt DateTime @default(now()) // 创建时间
  updatedAt DateTime @updatedAt // 更新时间
  userId    String // 用户ID 
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  word      WordBook @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
}

//单词表
model WordBook {
  id                  String               @id @default(cuid()) // 单词ID
  word                String // 单词
  phonetic            String? // 音标
  definition          String? // 定义
  translation         String? // 翻译
  pos                 String? // 词性
  collins             String? // 柯林斯
  oxford              String? // 牛津
  tag                 String? // 标签
  bnc                 String? // BNC 英国国家语料库
  frq                 String? // FRQ 频率
  exchange            String? // 同义词
  gk                  Boolean? // 高考
  zk                  Boolean? // 中考
  gre                 Boolean? // GRE
  toefl               Boolean? // TOEFL 
  ielts               Boolean? // IELTS 
  cet6                Boolean? // 大学英语六级
  cet4                Boolean? // 大学英语四级
  ky                  Boolean? // 考研
  createdAt           DateTime             @default(now()) // 创建时间
  updatedAt           DateTime             @updatedAt // 更新时间
  wordBookRecords     WordBookRecord[]
  learningItemStates  LearningItemState[]
  exerciseItemTargets ExerciseItemTarget[]
  knowledgeDocuments  KnowledgeDocument[]

  @@index([word])
  @@index([tag])
  @@index([word, tag])
}

//支付记录
model PaymentRecord {
  id            String         @id @default(cuid()) // 支付ID
  userId        String // 用户ID
  tradeNo       String? // 支付宝交易号
  outTradeNo    String         @unique // 订单编号
  amount        Decimal // 支付金额
  subject       String // 支付主题
  body          String // 支付内容
  tradeStatus   TradeStatus    @default(NOT_PAY) // 支付状态 默认未支付 NOT_PAY, SUCCESS, FAILED
  sendPayTime   DateTime? // 支付时间
  createdAt     DateTime       @default(now()) // 创建时间
  updatedAt     DateTime       @updatedAt // 更新时间
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseRecords CourseRecord[]

  @@index([tradeNo])
}

model CourseRecord {
  id              String         @id @default(cuid()) // 课程记录ID
  userId          String // 用户ID
  courseId        String // 课程ID
  isPurchased     Boolean        @default(false) // 是否购买
  createdAt       DateTime       @default(now()) // 创建时间
  updatedAt       DateTime       @updatedAt // 更新时间
  paymentRecordId String? // 支付记录ID
  paymentRecord   PaymentRecord? @relation(fields: [paymentRecordId], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  course          Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Course {
  id              String           @id @default(cuid()) // 课程ID
  name            String // 课程名
  value           String // 课程value
  description     String? // 课程描述
  teacher         String // 教师
  url             String // 课程url
  price           Decimal // 课程价格
  createdAt       DateTime         @default(now()) // 创建时间
  updatedAt       DateTime         @updatedAt // 更新时间
  courseRecords   CourseRecord[]
  learnerProfiles LearnerProfile[]
  knowledgeDocuments KnowledgeDocument[]
}

model LearnerProfile {
  id             String              @id @default(cuid())
  userId         String              @unique
  cefrLevel      CefrLevel?
  levelSource    LearnerLevelSource?
  goalType       LearnerGoalType?
  goalText       String?             @db.VarChar(500)
  activeCourseId String?
  timezone       String              @default("Asia/Shanghai") @db.VarChar(64)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeCourse   Course?             @relation(fields: [activeCourseId], references: [id], onDelete: SetNull)

  @@index([activeCourseId])
}

model LearningItemState {
  id              String                @id @default(cuid())
  userId          String
  targetType      LearningTargetType
  targetKey       String                @db.VarChar(128)
  wordId          String?
  reviewState     LearningReviewState   @default(NEW)
  repetitionCount Int                   @default(0)
  easeFactor      Decimal               @default(2.5) @db.Decimal(4, 2)
  intervalDays    Int                   @default(0)
  dueAt           DateTime?
  lastReviewedAt  DateTime?
  lastQuality     Int?
  lastAttemptId   String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  word            WordBook?             @relation(fields: [wordId], references: [id], onDelete: Cascade)
  lastAttempt     LearningAttempt?      @relation("LatestItemAttempt", fields: [lastAttemptId], references: [id], onDelete: SetNull)
  reviewEvents    LearningReviewEvent[]

  @@unique([userId, targetType, targetKey])
  @@index([userId, targetType, dueAt])
  @@index([wordId])
}

model LearningReviewEvent {
  id            String             @id @default(cuid())
  userId        String
  itemStateId   String
  attemptId     String
  targetType    LearningTargetType
  targetKey     String             @db.VarChar(128)
  itemScore     Int
  quality       Int
  previousState Json
  nextState     Json
  createdAt     DateTime           @default(now())
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemState     LearningItemState  @relation(fields: [itemStateId], references: [id], onDelete: Cascade)
  attempt       LearningAttempt    @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, targetType, targetKey])
  @@index([userId, createdAt])
  @@index([itemStateId, createdAt])
}

model CoachConversation {
  id                 String                  @id @default(cuid())
  userId             String
  title              String?                 @db.VarChar(120)
  status             CoachConversationStatus @default(ACTIVE)
  checkpointThreadId String                  @unique @db.VarChar(128)
  lastActivityAt     DateTime                @default(now())
  expiresAt          DateTime
  deletedAt          DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages           CoachMessage[]
  requests           CoachRequest[]
  exercises          Exercise[]

  @@index([userId, status, lastActivityAt])
}

model CoachMessage {
  id                  String            @id @default(cuid())
  conversationId      String
  requestId           String?
  role                CoachMessageRole
  content             String?
  resultSchemaVersion String?           @db.VarChar(64)
  structuredResult    Json?
  createdAt           DateTime          @default(now())
  conversation        CoachConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  request             CoachRequest?     @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt, id])
  @@index([requestId])
}

model CoachRequest {
  id                       String                @id @default(cuid())
  userId                   String
  conversationId           String
  clientRequestKey         String                @db.VarChar(128)
  requestBodyHash          String                @db.VarChar(128)
  inputPayload             Json
  retryOfRequestId         String?
  inputType                CoachRequestInputType
  intent                   CoachIntent?
  status                   CoachRequestStatus    @default(CREATED)
  exerciseId               String?
  answerVersion            String?               @db.VarChar(128)
  promptVersion            String?               @db.VarChar(128)
  modelVersion             String?               @db.VarChar(128)
  budgetVersion            String?               @db.VarChar(128)
  deadlineAt               DateTime
  finalResultSchemaVersion String?               @db.VarChar(64)
  finalResult              Json?
  errorCode                CoachErrorCode?
  cancelRequestedAt        DateTime?
  queuedAt                 DateTime?
  startedAt                DateTime?
  firstTokenAt             DateTime?
  finishedAt               DateTime?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  user                     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation             CoachConversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  retryOfRequest           CoachRequest?         @relation("CoachRequestRetries", fields: [retryOfRequestId], references: [id], onDelete: SetNull)
  retries                  CoachRequest[]        @relation("CoachRequestRetries")
  exercise                 Exercise?             @relation("RequestExerciseContext", fields: [exerciseId], references: [id], onDelete: SetNull)
  generatedExercise        Exercise?             @relation("ExerciseGenerationRequest")
  messages                 CoachMessage[]
  gradedSubmission         ExerciseSubmission?   @relation("SubmissionGradeRequest")
  savedAttempt             LearningAttempt?      @relation("AttemptSaveRequest")
  trace                    CoachTrace?
  feedback                 CoachFeedback[]
  knowledgeCitations       KnowledgeCitation[]

  @@unique([userId, clientRequestKey])
  @@index([conversationId, status, createdAt])
  @@index([retryOfRequestId])
  @@index([exerciseId])
}

model Exercise {
  id                    String               @id @default(cuid())
  userId                String
  conversationId        String
  requestId             String               @unique
  type                  ExerciseType
  status                ExerciseStatus       @default(DRAFT)
  cefrDifficulty        ExerciseDifficulty
  instructions          String               @db.VarChar(2000)
  personalizationReason String               @db.VarChar(2000)
  schemaVersion         String               @db.VarChar(64)
  citations             Json
  expiresAt             DateTime
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation          CoachConversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  request               CoachRequest         @relation("ExerciseGenerationRequest", fields: [requestId], references: [id], onDelete: Cascade)
  contextualRequests    CoachRequest[]       @relation("RequestExerciseContext")
  items                 ExerciseItem[]
  submissions           ExerciseSubmission[]
  attempts              LearningAttempt[]

  @@index([userId, status, createdAt])
  @@index([conversationId])
}

model ExerciseItem {
  id              String                   @id @default(cuid())
  exerciseId      String
  position        Int
  prompt          String
  choices         Json?
  answerKey       Json
  gradingRubric   Json
  maxScore        Int
  citations       Json
  exercise        Exercise                 @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  targets         ExerciseItemTarget[]
  submissionItems ExerciseSubmissionItem[]

  @@unique([exerciseId, position])
}

model ExerciseItemTarget {
  exerciseItemId String
  targetType     LearningTargetType
  targetKey      String             @db.VarChar(128)
  wordId         String?
  weight         Decimal            @db.Decimal(5, 4)
  exerciseItem   ExerciseItem       @relation(fields: [exerciseItemId], references: [id], onDelete: Cascade)
  word           WordBook?          @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@id([exerciseItemId, targetType, targetKey])
  @@index([wordId])
}

model ExerciseSubmission {
  id                   String                   @id @default(cuid())
  userId               String
  exerciseId           String
  gradeRequestId       String                   @unique
  answerVersion        String                   @db.VarChar(128)
  clientIdempotencyKey String                   @db.VarChar(128)
  answers              Json
  status               ExerciseSubmissionStatus @default(RECEIVED)
  score                Int?
  gradingHash          String?                  @db.VarChar(128)
  resultSchemaVersion  String?                  @db.VarChar(64)
  gradingResult        Json?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  user                 User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise             Exercise                 @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  gradeRequest         CoachRequest             @relation("SubmissionGradeRequest", fields: [gradeRequestId], references: [id], onDelete: Cascade)
  items                ExerciseSubmissionItem[]
  attempt              LearningAttempt?

  @@unique([userId, exerciseId, answerVersion])
  @@unique([userId, clientIdempotencyKey])
  @@index([exerciseId, status])
}

model ExerciseSubmissionItem {
  id              String             @id @default(cuid())
  submissionId    String
  exerciseItemId  String
  answer          Json
  isCorrect       Boolean?
  score           Int?
  correction      String
  explanation     String
  errorTypes      Json
  targetQualities Json
  submission      ExerciseSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  exerciseItem    ExerciseItem       @relation(fields: [exerciseItemId], references: [id], onDelete: Cascade)

  @@unique([submissionId, exerciseItemId])
  @@index([exerciseItemId])
}

model LearningAttempt {
  id               String                @id @default(cuid())
  userId           String
  exerciseId       String
  submissionId     String                @unique
  saveRequestId    String                @unique
  score            Int
  errorTypes       Json
  gradingHash      String                @db.VarChar(128)
  savedAt          DateTime              @default(now())
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise         Exercise              @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  submission       ExerciseSubmission    @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  saveRequest      CoachRequest          @relation("AttemptSaveRequest", fields: [saveRequestId], references: [id], onDelete: Cascade)
  reviewEvents     LearningReviewEvent[]
  latestItemStates LearningItemState[]   @relation("LatestItemAttempt")

  @@unique([userId, exerciseId, submissionId])
  @@index([userId, savedAt])
}

model CoachTrace {
  id                  String               @id
  requestId           String               @unique
  traceSubjectId      String?
  promptVersion       String               @db.VarChar(128)
  promptHash          String               @db.VarChar(128)
  modelProvider       String               @db.VarChar(64)
  modelName           String               @db.VarChar(128)
  modelVersion        String               @db.VarChar(128)
  resultSchemaVersion String               @db.VarChar(64)
  budgetVersion       String               @db.VarChar(128)
  ttftMs              Int?
  totalDurationMs     Int?
  inputTokens         Int                  @default(0)
  outputTokens        Int                  @default(0)
  estimatedCost       Decimal              @default(0) @db.Decimal(18, 8)
  currency            String               @db.VarChar(8)
  schemaFailureCount  Int                  @default(0)
  retryCount          Int                  @default(0)
  terminalStatus      CoachRequestStatus
  resultType          CoachResponseType?
  recommendation      Json?
  createdAt           DateTime             @default(now())
  expiresAt           DateTime
  request             CoachRequest         @relation(fields: [requestId], references: [id], onDelete: Cascade)
  traceSubject        TraceSubjectMapping? @relation(fields: [traceSubjectId], references: [traceSubjectId], onDelete: SetNull)
  steps               CoachStepTrace[]

  @@index([traceSubjectId, createdAt])
  @@index([expiresAt])
}

model CoachDeletionTombstone {
  id            String              @id
  subjectHash   String              @db.VarChar(128)
  resourceHash  String              @db.VarChar(128)
  scope         CoachDeletionScope
  status        CoachDeletionStatus @default(ACCEPTED)
  requestedAt   DateTime
  hiddenAt      DateTime
  purgeDeadline DateTime
  completedAt   DateTime?
  expiresAt     DateTime
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([subjectHash, scope, resourceHash])
  @@index([status, purgeDeadline])
  @@index([expiresAt])
}

model CoachStepTrace {
  id                 String          @id @default(cuid())
  traceId            String
  sequence           Int
  stepName           CoachStepName
  toolName           CoachToolName?
  status             CoachStepStatus
  durationMs         Int?
  inputTokens        Int             @default(0)
  outputTokens       Int             @default(0)
  schemaFailureCount Int             @default(0)
  retryCount         Int             @default(0)
  errorCode          CoachErrorCode?
  redactedMetadata   Json?
  createdAt          DateTime        @default(now())
  trace              CoachTrace      @relation(fields: [traceId], references: [id], onDelete: Cascade)

  @@unique([traceId, sequence])
}

model CoachFeedback {
  id                   String                 @id @default(cuid())
  userId               String
  requestId            String
  clientIdempotencyKey String                 @db.VarChar(128)
  requestBodyHash      String                 @db.VarChar(128)
  rating               CoachFeedbackRating
  category             CoachFeedbackCategory?
  comment              String?                @db.VarChar(1000)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  expiresAt            DateTime
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  request              CoachRequest           @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([userId, requestId])
  @@unique([userId, clientIdempotencyKey])
  @@index([expiresAt])
}

model TraceSubjectMapping {
  traceSubjectId String       @id
  userId         String       @unique
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  traces         CoachTrace[]
}

model KnowledgeSource {
  id                  String                       @id @default(cuid())
  sourceKey           String                       @unique @db.VarChar(128)
  name                String                       @db.VarChar(300)
  sourceType          String                       @db.VarChar(64)
  licenseRef          String?                      @db.VarChar(500)
  rightsVersion       String                       @db.VarChar(128)
  status              KnowledgeSourceStatus        @default(DRAFT)
  allowEmbedding      Boolean                      @default(false)
  allowExcerptDisplay Boolean                      @default(false)
  allowEvaluation     Boolean                      @default(false)
  verifiedAt          DateTime?
  validFrom           DateTime?
  validUntil          DateTime?
  revokedAt           DateTime?
  deletedAt           DateTime?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  fieldPolicies       KnowledgeSourceFieldPolicy[]
  documents           KnowledgeDocument[]
  ingestionJobs       KnowledgeIngestionJob[]

  @@index([status, validUntil])
}

model KnowledgeSourceFieldPolicy {
  id                  String            @id @default(cuid())
  knowledgeSourceId   String
  recordType          String            @db.VarChar(64)
  fieldName           String            @db.VarChar(128)
  allowEmbedding      Boolean           @default(false)
  allowExcerptDisplay Boolean           @default(false)
  allowEvaluation     Boolean           @default(false)
  contentCategory     KnowledgeCategory
  policyVersion       String            @db.VarChar(128)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  knowledgeSource     KnowledgeSource   @relation(fields: [knowledgeSourceId], references: [id], onDelete: Cascade)

  @@unique([knowledgeSourceId, recordType, fieldName, policyVersion])
}

model KnowledgeRelease {
  id                       String                 @id @default(cuid())
  scopeKey                 String                 @db.VarChar(300)
  contentVersion           String                 @db.VarChar(128)
  rightsVersion            String                 @db.VarChar(128)
  chunkingVersion          String                 @db.VarChar(128)
  embeddingVersion         String                 @db.VarChar(256)
  retrievalConfigVersion   String                 @db.VarChar(128)
  indexVersion             String                 @db.VarChar(128)
  expectedChunkCount       Int                    @default(0)
  readyEmbeddingCount      Int                    @default(0)
  status                   KnowledgeReleaseStatus @default(BUILDING)
  activatedAt              DateTime?
  invalidatedAt            DateTime?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  documents                KnowledgeDocument[]

  @@unique([scopeKey, contentVersion, rightsVersion, chunkingVersion, embeddingVersion])
  @@index([status, embeddingVersion, retrievalConfigVersion])
}

model KnowledgeDocument {
  id                  String                  @id @default(cuid())
  knowledgeSourceId   String
  releaseId           String
  source              String                  @db.VarChar(128)
  sourceId            String                  @db.VarChar(300)
  sourceRecordType    String                  @db.VarChar(64)
  sourceRecordId      String                  @db.VarChar(128)
  title               String                  @db.VarChar(300)
  contentVersion      String                  @db.VarChar(128)
  visibility          String                  @db.VarChar(16)
  accessScope         KnowledgeAccessScope
  userId              String?
  courseId            String?
  wordId              String?
  status              KnowledgeDocumentStatus @default(STAGED)
  sourceUpdatedAt     DateTime
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  knowledgeSource     KnowledgeSource         @relation(fields: [knowledgeSourceId], references: [id], onDelete: Cascade)
  release             KnowledgeRelease        @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  user                User?                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course              Course?                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  word                WordBook?               @relation(fields: [wordId], references: [id], onDelete: Cascade)
  chunks              KnowledgeChunk[]
  citations           KnowledgeCitation[]

  @@unique([knowledgeSourceId, sourceRecordType, sourceRecordId, contentVersion])
  @@index([status, accessScope, userId])
  @@index([status, courseId])
  @@index([wordId])
}

model KnowledgeChunk {
  id               String               @id @default(cuid())
  documentId       String
  chunkKey         String               @db.VarChar(200)
  ordinal          Int
  content          String
  contentHash      String               @db.VarChar(128)
  chunkingVersion  String               @db.VarChar(128)
  source           String               @db.VarChar(128)
  sourceId         String               @db.VarChar(300)
  title            String               @db.VarChar(300)
  category         KnowledgeCategory
  level            CefrLevel?
  courseId         String?
  wordId           String?
  userId           String?
  visibility       String               @db.VarChar(16)
  contentVersion   String               @db.VarChar(128)
  factKey          String?              @db.VarChar(300)
  factValueHash    String?              @db.VarChar(128)
  authorityRank    Int?
  status           KnowledgeChunkStatus @default(STAGED)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  document         KnowledgeDocument    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  embeddings       KnowledgeEmbedding[]
  citations        KnowledgeCitation[]

  @@unique([documentId, chunkingVersion, chunkKey, contentHash])
  @@index([documentId, status])
  @@index([category, level])
  @@index([courseId, status])
  @@index([wordId, status])
  @@index([userId, status])
  @@index([factKey])
}

model KnowledgeEmbedding {
  id               String                   @id @default(cuid())
  chunkId          String
  provider         String                   @db.VarChar(64)
  model            String                   @db.VarChar(128)
  dimensions       Int
  embeddingVersion String                   @db.VarChar(256)
  inputHash        String                   @db.VarChar(128)
  embedding        Unsupported("vector")?
  status           KnowledgeEmbeddingStatus @default(PENDING)
  failureCode      String?                  @db.VarChar(64)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  chunk            KnowledgeChunk           @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@unique([chunkId, embeddingVersion, inputHash])
  @@index([embeddingVersion, dimensions, status, chunkId])
}

model KnowledgeIngestionJob {
  id                  String                      @id @default(cuid())
  operation           KnowledgeIngestionOperation
  knowledgeSourceId   String
  sourceRecordType    String                      @db.VarChar(64)
  sourceRecordId      String                      @db.VarChar(128)
  contentVersion      String?                     @db.VarChar(128)
  pipelineVersion     String                      @db.VarChar(256)
  ownerUserId         String?
  status              KnowledgeIngestionStatus    @default(PENDING)
  attemptCount        Int                         @default(0)
  nextAttemptAt       DateTime?
  claimedAt           DateTime?
  finishedAt          DateTime?
  failureCode         String?                     @db.VarChar(64)
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  knowledgeSource     KnowledgeSource             @relation(fields: [knowledgeSourceId], references: [id], onDelete: Cascade)

  @@unique([operation, sourceRecordType, sourceRecordId, contentVersion, pipelineVersion])
  @@index([status, nextAttemptAt, createdAt])
}

model PrivateLearningSummary {
  id              String                            @id @default(cuid())
  userId          String
  topicType       PrivateLearningSummaryTopicType
  topicKey        String                            @db.VarChar(128)
  windowStart     DateTime
  windowEnd       DateTime
  summaryFacts    Json
  evidenceVersion String                            @db.VarChar(128)
  status          PrivateLearningSummaryStatus      @default(ACTIVE)
  createdAt       DateTime                          @default(now())
  updatedAt       DateTime                          @updatedAt
  user            User                              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, topicType, topicKey, status])
}

model KnowledgeCitation {
  id                String                  @id @db.VarChar(64)
  requestId         String
  chunkId           String?
  documentId        String?
  sourceId          String?                 @db.VarChar(300)
  sourceIdHash      String                  @db.VarChar(128)
  contentVersion    String                  @db.VarChar(128)
  embeddingVersion  String                  @db.VarChar(256)
  excerpt           String?                 @db.VarChar(2000)
  excerptHash       String                  @db.VarChar(128)
  rank              Int
  relevanceScore    Decimal                 @db.Decimal(8, 7)
  status            KnowledgeCitationStatus @default(ACTIVE)
  invalidatedAt     DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  request           CoachRequest            @relation(fields: [requestId], references: [id], onDelete: Cascade)
  chunk             KnowledgeChunk?         @relation(fields: [chunkId], references: [id], onDelete: SetNull)
  document          KnowledgeDocument?      @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@unique([requestId, chunkId, contentVersion])
  @@index([requestId, status])
  @@index([chunkId, status])
  @@index([sourceIdHash, contentVersion])
}

//访客表(UV)
model Visitor {
  id                 String             @id @default(cuid()) // 访客ID
  anonymousId        String             @unique // 匿名ID
  userId             String? // 用户ID
  user               User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime           @default(now()) // 创建时间
  updatedAt          DateTime           @updatedAt // 更新时间
  browser            String? // 浏览器信息
  os                 String? // 操作系统信息
  device             String? // 设备信息
  pageViews          PageView[]
  trackEvents        TrackEvent[]
  performanceEntries PerformanceEntry[]
  errorEntries       ErrorEntry[]

  @@index([userId])
  @@index([anonymousId])
}

//pv表
model PageView {
  id        String   @id @default(cuid()) // pvID
  visitorId String // 访客ID
  visitor   Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  url       String // 页面URL
  referrer  String? // 来源URL
  path      String // 页面路径
  createdAt DateTime @default(now()) // 创建时间
  updatedAt DateTime @updatedAt // 更新时间

  @@index([visitorId, createdAt])
  @@index([path, createdAt])
}

//用户行为表
model TrackEvent {
  id        String   @id @default(cuid()) // 行为ID
  visitorId String // 访客ID
  visitor   Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  event     String // 事件类型
  payload   Json? // 事件数据
  url       String? // 页面URL
  createdAt DateTime @default(now()) // 创建时间
  updatedAt DateTime @updatedAt // 更新时间

  @@index([visitorId, createdAt])
  @@index([event, createdAt])
}

//性能指标
model PerformanceEntry {
  id        String   @id @default(cuid()) // 性能指标ID
  visitorId String // 访客ID
  visitor   Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  fp        Float? // FP
  fcp       Float? // FCP
  lcp       Float? // LCP
  inp       Float? // INP
  cls       Float? // CLS
  createdAt DateTime @default(now()) // 创建时间
  updatedAt DateTime @updatedAt // 更新时间

  @@index([fp, createdAt])
  @@index([fcp, createdAt])
  @@index([lcp, createdAt])
  @@index([inp, createdAt])
  @@index([cls, createdAt])
  @@index([fp, fcp, lcp, inp, cls, createdAt])
}

model ErrorEntry {
  id        String   @id @default(cuid()) // 错误指标ID
  visitorId String // 访客ID
  visitor   Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  error     String // 错误类型 js |promise
  message   String? // 错误信息
  stack     String? // 错误堆栈
  url       String? // 页面URL
  createdAt DateTime @default(now()) // 创建时间
  updatedAt DateTime @updatedAt // 更新时间

  @@index([visitorId, createdAt])
  @@index([error, createdAt])
}
