# Coach remains fail-closed until each capability is explicitly enabled.
COACH_ENABLED=false
COACH_LIVE_MODEL_ENABLED=false
COACH_WRITE_ENABLED=false

# Required before live-model or write enablement. Do not use placeholders in production.
COACH_MODEL_NAME=
COACH_MODEL_VERSION=
COACH_MODEL_PRICE_VERSION=
COACH_BUDGET_POLICY_VERSION=
COACH_EVAL_DATASET_VERSION=

# Measured and approved runtime governance values. Keep approval false until
# the versioned baseline and candidate reports have been reviewed.
COACH_BUDGET_POLICY_APPROVED=false
COACH_MAX_INPUT_TOKENS=
COACH_MAX_OUTPUT_TOKENS=
COACH_MAX_MODEL_CALLS=
COACH_MAX_TOOL_CALLS=
COACH_MAX_COST_MICROS=
COACH_MAX_DURATION_MS=
COACH_MAX_MODEL_INPUT_TOKENS_PER_CALL=
COACH_MAX_MODEL_OUTPUT_TOKENS_PER_CALL=
COACH_MODEL_INPUT_PRICE_MICROS_PER_MILLION_TOKENS=
COACH_MODEL_OUTPUT_PRICE_MICROS_PER_MILLION_TOKENS=
COACH_MODEL_PRICE_VALID_FROM=
COACH_MODEL_PRICE_VALID_UNTIL=
COACH_RATE_LIMIT_WINDOW_SECONDS=
COACH_RATE_LIMIT_SUBJECT_COUNT=
COACH_RATE_LIMIT_IP_COUNT=
COACH_MAX_CONCURRENT_REQUESTS=

# HMAC pepper for non-reversible Trace subject identifiers. Never log it.
COACH_TRACE_PEPPER=

# Pronunciation: keep off until real resource/price/privacy evidence is configured.
# See docs/pronunciation-runtime.md; browser capability flags come from the server.
PRONUNCIATION_CAPTURE_ENABLED=false
PRONUNCIATION_UPLOAD_ENABLED=false
PRONUNCIATION_PROVIDER_ENABLED=false
PRONUNCIATION_RESULT_DISPLAY_ENABLED=false
PRONUNCIATION_LEARNING_SHADOW_ENABLED=false
PRONUNCIATION_LEARNING_WRITE_ENABLED=false
PRONUNCIATION_COACH_SUMMARY_ENABLED=false
PRONUNCIATION_AUDIO_RUNTIME_APPROVED=false
PRONUNCIATION_STORAGE_APPROVED=false
PRONUNCIATION_PROVIDER_APPROVED=false
PRONUNCIATION_MODEL_IDENTITY_VENDOR_ATTESTED=false
PRONUNCIATION_MODEL_IDENTITY_IMMUTABLE=false
PRONUNCIATION_MODEL_IDENTITY_QUERYABLE=false
# Azure 门户完整基础终结点优先；例如 https://eastasia.api.cognitive.microsoft.com/
AZURE_SPEECH_ENDPOINT=
# 已填写 ENDPOINT 时资源名可留空；兼容已有资源专属域名配置
AZURE_SPEECH_RESOURCE_NAME=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Explicit Azure portal tier; F0 requires price 0 and <=18000 monthly audio seconds.
AZURE_SPEECH_TIER=F0
PRONUNCIATION_MODEL_IDENTITY_MODE=AZURE_MANAGED
PRONUNCIATION_SUBJECT_DAILY_AUDIO_SECONDS=300
PRONUNCIATION_DAILY_AUDIO_SECONDS=1800
PRONUNCIATION_MONTHLY_AUDIO_SECONDS=14400
PRONUNCIATION_AUDIO_BUCKET=
PRONUNCIATION_TRACE_PEPPER=
PRONUNCIATION_REDIS_DB=
PRONUNCIATION_FFMPEG_PATH=
PRONUNCIATION_FFPROBE_PATH=
PRONUNCIATION_PROVIDER_MODEL_VERSION=
PRONUNCIATION_PROVIDER_REGION=
PRONUNCIATION_MODEL_IDENTITY_EVIDENCE_VERSION=
PRONUNCIATION_PRIVACY_EVIDENCE_VERSION=
PRONUNCIATION_PRICE_VERSION=
PRONUNCIATION_BUDGET_POLICY_VERSION=
PRONUNCIATION_EVALUATION_APPROVAL_VERSION=
PRONUNCIATION_CURRENCY=
PRONUNCIATION_PRICE_MICROS_PER_SECOND=
PRONUNCIATION_MINIMUM_BILLABLE_MS=
PRONUNCIATION_PRICE_VALID_FROM=
PRONUNCIATION_PRICE_VALID_UNTIL=
PRONUNCIATION_MAX_CALL_COST_MICROS=
PRONUNCIATION_SUBJECT_DAILY_BUDGET_MICROS=
PRONUNCIATION_SYSTEM_DAILY_BUDGET_MICROS=
PRONUNCIATION_SYSTEM_MONTHLY_BUDGET_MICROS=
